{"number":109,"name_fa":"کافرون","name_ar":"سُوْرَةُ الْكَافِرُوْنَ","name_en":"The Disbelievers","revelation":"مکی","ayah_count":6,"ayahs":[{"a":109,"v":1,"ar":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ قُلْ يَا أَيُّهَا الْكَافِرُونَ","fa":"بگو: «اى كافران،"},{"a":109,"v":2,"ar":"لَا أَعْبُدُ مَا تَعْبُدُونَ","fa":"آنچه مى‌پرستيد، نمى‌پرستم"},{"a":109,"v":3,"ar":"وَلَا أَنْتُمْ عَابِدُونَ مَا أَعْبُدُ","fa":"و آنچه مى‌پرستم، شما نمى‌پرستيد"},{"a":109,"v":4,"ar":"وَلَا أَنَا عَابِدٌ مَا عَبَدْتُمْ","fa":"و نه آنچه پرستيديد من مى‌پرستم"},{"a":109,"v":5,"ar":"وَلَا أَنْتُمْ عَابِدُونَ مَا أَعْبُدُ","fa":"و نه آنچه مى‌پرستم شما مى‌پرستيد"},{"a":109,"v":6,"ar":"لَكُمْ دِينُكُمْ وَلِيَ دِينِ","fa":"دين شما براى خودتان، و دين من براى خودم.»"}]}