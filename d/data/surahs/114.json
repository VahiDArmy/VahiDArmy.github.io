{"number":114,"name_fa":"ناس","name_ar":"سُوْرَةُ النَّاسِ","name_en":"Mankind","revelation":"مکی","ayah_count":6,"ayahs":[{"a":114,"v":1,"ar":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ قُلْ أَعُوذُ بِرَبِّ النَّاسِ","fa":"بگو: «پناه مى‌برم به پروردگار مردم،"},{"a":114,"v":2,"ar":"مَلِكِ النَّاسِ","fa":"پادشاه مردم،"},{"a":114,"v":3,"ar":"إِلَٰهِ النَّاسِ","fa":"معبود مردم،"},{"a":114,"v":4,"ar":"مِنْ شَرِّ الْوَسْوَاسِ الْخَنَّاسِ","fa":"از شرّ وسوسه‌گر نهانى؛"},{"a":114,"v":5,"ar":"الَّذِي يُوَسْوِسُ فِي صُدُورِ النَّاسِ","fa":"آن كس كه در سينه‌هاى مردم وسوسه مى‌كند،"},{"a":114,"v":6,"ar":"مِنَ الْجِنَّةِ وَالنَّاسِ","fa":"چه از جنّ و [چه از] انس.»"}]}